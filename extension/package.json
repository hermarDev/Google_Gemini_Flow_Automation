{
  "name": "ai-media-automator-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome MV3 companion extension for Google Flow and Gemini Chat media generation automation",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "playwright test",
    "test:extension": "playwright test --config=playwright-extension.config.ts",
    "test:smoke:install": "playwright install chromium",
    "test:smoke:install:deps": "playwright install-deps chromium"
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.312",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
